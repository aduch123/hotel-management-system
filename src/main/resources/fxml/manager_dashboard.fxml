<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/11"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hotel.controllers.ManagerDashboardController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Text text="Hotel Management System" fill="white" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <Label text="MANAGER DASHBOARD" style="-fx-text-fill: white; -fx-font-size: 16px;" />
            </HBox>

            <HBox spacing="15" alignment="CENTER">
                <Button text="All Rooms" fx:id="roomsButton" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                <Button text="All Bookings" fx:id="bookingsButton" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                <Button text="Logout" fx:id="logoutButton" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <Text text="Manager Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Label text="Full system access: Rooms, Bookings, Staff, Reports"
                   style="-fx-font-size: 14px; -fx-text-fill: #666;" />
            <Label fx:id="statusLabel" style="-fx-font-size: 12px; -fx-text-fill: #666;" />
        </VBox>
    </center>
</BorderPane>